{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Upscaly",
  "version": "0.1.0",
  "identifier": "com.shaya.ai-upscaler",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Upscaly",
        "width": 1280,
        "height": 800,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost blob: data:; media-src 'self' asset: https://asset.localhost blob: data:; script-src 'self'; style-src 'self' 'unsafe-inline';",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/realesrgan-ncnn-vulkan",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzN0M5Q0MyMjJCQzEyNzIKUldSeUVyd2l3cHg4ZzF2LytPRjl6N1Z1Zy9XVEZTUm5SNW41Q2d2UDZRU1FvOVJHNlJWTFI3bmUK",
      "endpoints": [
        "https://github.com/shayann07/Upscaly/releases/latest/download/latest.json"
      ]
    }
  }
}
