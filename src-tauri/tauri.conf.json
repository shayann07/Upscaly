{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Upscaly Studio",
  "version": "1.0.2",
  "identifier": "com.wexpa.upscaly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Upscaly Studio",
        "width": 1280,
        "height": 800,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#110F0E"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; script-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'none';",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Wexpa",
    "copyright": "Copyright (c) 2026 Wexpa (Shayan). MIT Licensed.",
    "homepage": "https://github.com/shayann07/Upscaly",
    "shortDescription": "Local AI image and video upscaler",
    "longDescription": "Upscale images and video locally on your own GPU with Real-ESRGAN. No account, no uploads, no metering.",
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/realesrgan-ncnn-vulkan"
    ],
    "resources": {
      "resources/provision-ffmpeg.ps1": "resources/provision-ffmpeg.ps1",
      "sidecar-manifest.json": "sidecar-manifest.json",
      "binaries/vcomp140.dll": "vcomp140.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installMode": "currentUser",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzN0M5Q0MyMjJCQzEyNzIKUldSeUVyd2l3cHg4ZzF2LytPRjl6N1Z1Zy9XVEZTUm5SNW41Q2d2UDZRU1FvOVJHNlJWTFI3bmUK",
      "endpoints": [
        "https://github.com/shayann07/Upscaly/releases/latest/download/latest.json"
      ]
    }
  }
}
